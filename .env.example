# ─── Local development ────────────────────────────────────────────────────────
# Option A: SQLite (zero setup, default)
DATABASE_URL="file:./dev.db"

# Option B: Local Postgres via docker-compose
#   1. docker compose up -d
#   2. Run: DATABASE_URL="postgresql://comicatlas:comicatlas@localhost:5432/comicatlas"
#      then: npx prisma migrate deploy && npx prisma db seed
# DATABASE_URL="postgresql://comicatlas:comicatlas@localhost:5432/comicatlas"

NEXTAUTH_SECRET="change-this-to-a-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"

# ─── Production (Vercel + Neon) ───────────────────────────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# NEXTAUTH_SECRET="<openssl rand -base64 32>"
# NEXTAUTH_URL="https://your-app.vercel.app"
