{
  "name": "comicatlas-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:spoilers": "ts-node --project scripts/tsconfig.json prisma/apply-spoilers.ts",
    "smoke": "ts-node --project scripts/tsconfig.json scripts/smoke.ts",
    "import:images": "dotenv run -f .env.local -- ts-node --project scripts/tsconfig.json scripts/cv-import.ts",
    "cv:search": "dotenv run -f .env.local -- ts-node --project scripts/tsconfig.json scripts/cv-search.ts",
    "cv:verify": "dotenv run -f .env.local -- ts-node --project scripts/tsconfig.json scripts/cv-verify.ts"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@libsql/client": "^0.18.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/ws": "^8.18.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "next": "16.3.8",
    "next-auth": "^4.24.15",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
