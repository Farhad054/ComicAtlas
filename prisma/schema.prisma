generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  password       String?
  spoilerModeOn  Boolean          @default(false)
  createdAt      DateTime         @default(now())
  readingProgress ReadingProgress[]
  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Publisher {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique
  characters Character[]
  teams      Team[]
  issues     Issue[]
  events     Event[]
}

model Character {
  id                  String           @id @default(cuid())
  publisherId         String
  name                String
  aliases             String           @default("[]")
  realName            String?
  bio                 String
  powers              String           @default("[]")
  firstAppearanceYear Int?
  firstAppearanceIssue String?
  creators            String           @default("[]")
  currentStatusText   String?
  imageUrl            String?
  imageOverrideUrl    String?
  publisher           Publisher        @relation(fields: [publisherId], references: [id])
  readingPaths        ReadingPath[]
  relationshipsA      Relationship[]   @relation("CharacterA")
  relationshipsB      Relationship[]   @relation("CharacterB")
  impactEntries       ImpactEntry[]
  timelineEvents      TimelineEvent[]
  teamMemberships     TeamMembership[]
}

model TimelineEvent {
  id          String    @id @default(cuid())
  characterId String
  year        Int
  title       String
  description String
  order       Int
  character   Character @relation(fields: [characterId], references: [id])
}

model Team {
  id                   String             @id @default(cuid())
  publisherId          String
  name                 String
  slug                 String             @unique
  bio                  String
  baseOfOperations     String?
  currentStatusText    String?
  imageUrl             String?
  imageOverrideUrl     String?
  firstAppearanceIssue String?
  firstAppearanceYear  Int?
  creators             String             @default("[]")
  publisher            Publisher          @relation(fields: [publisherId], references: [id])
  memberships          TeamMembership[]
  lineups              TeamLineup[]
  readingPaths         ReadingPath[]
  eventTeams           EventTeam[]
  relationshipsA       TeamRelationship[] @relation("TeamRelA")
  relationshipsB       TeamRelationship[] @relation("TeamRelB")
}

model TeamMembership {
  id          String     @id @default(cuid())
  teamId      String
  characterId String?
  displayName String
  role        String?
  joinedNote  String?
  leftNote    String?
  team        Team       @relation(fields: [teamId], references: [id])
  character   Character? @relation(fields: [characterId], references: [id])
}

model TeamLineup {
  id                 String @id @default(cuid())
  teamId             String
  name               String
  years              String?
  description        String?
  memberDisplayNames String @default("[]")
  team               Team   @relation(fields: [teamId], references: [id])
}

model EventTeam {
  id      String @id @default(cuid())
  eventId String
  teamId  String
  event   Event  @relation(fields: [eventId], references: [id])
  team    Team   @relation(fields: [teamId], references: [id])
  @@unique([eventId, teamId])
}

model TeamRelationship {
  id      String @id @default(cuid())
  teamAId String
  teamBId String
  type    String
  teamA   Team   @relation("TeamRelA", fields: [teamAId], references: [id])
  teamB   Team   @relation("TeamRelB", fields: [teamBId], references: [id])
}

model Issue {
  id             String           @id @default(cuid())
  publisherId    String
  seriesName     String
  issueNumber    String
  year           Int
  coverImageUrl  String?
  summary        String?
  publisher      Publisher        @relation(fields: [publisherId], references: [id])
  readingProgress ReadingProgress[]
  pathNodes      ReadingPathNode[]
}

model Event {
  id              String         @id @default(cuid())
  publisherId     String
  name            String
  summary         String
  cause           String?
  leadsFromEventId String?
  leadsToEventId  String?
  imageUrl        String?
  publisher       Publisher      @relation(fields: [publisherId], references: [id])
  readingPath     ReadingPath?
  impactEntries   ImpactEntry[]
  eventTeams      EventTeam[]
}

model ImpactEntry {
  id              String    @id @default(cuid())
  eventId         String
  characterId     String
  consequenceText String
  event           Event     @relation(fields: [eventId], references: [id])
  character       Character @relation(fields: [characterId], references: [id])
}

model ReadingPath {
  id          String            @id @default(cuid())
  characterId String?
  eventId     String?           @unique
  teamId      String?
  tier        String
  character   Character?        @relation(fields: [characterId], references: [id])
  event       Event?            @relation(fields: [eventId], references: [id])
  team        Team?             @relation(fields: [teamId], references: [id])
  nodes       ReadingPathNode[]
}

model ReadingPathNode {
  id              String      @id @default(cuid())
  readingPathId   String
  issueId         String
  whyItMatters    String
  required        Boolean     @default(true)
  estTimeMinutes  Int         @default(20)
  order           Int
  readingPath     ReadingPath @relation(fields: [readingPathId], references: [id])
  issue           Issue       @relation(fields: [issueId], references: [id])
}

model Relationship {
  id           String    @id @default(cuid())
  characterAId String
  characterBId String
  type         String
  characterA   Character @relation("CharacterA", fields: [characterAId], references: [id])
  characterB   Character @relation("CharacterB", fields: [characterBId], references: [id])
}

model ReadingProgress {
  id      String  @id @default(cuid())
  userId  String
  issueId String
  read    Boolean @default(false)
  user    User    @relation(fields: [userId], references: [id])
  issue   Issue   @relation(fields: [issueId], references: [id])
  @@unique([userId, issueId])
}
